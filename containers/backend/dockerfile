# Local Quill API. Build context is the repo root (see docker-compose.yml).
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    HF_HOME=/hf \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first: this layer is rebuilt only when pyproject.toml / uv.lock change.
# --no-dev skips notebooks, evaluation tooling and the old Chainlit UI.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY containers/backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Runtime state lives in volumes (see docker-compose.yml), not in the image.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /hf /app/chroma /app/data \
    && chown -R app:app /hf /app/chroma /app/data
USER app

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
